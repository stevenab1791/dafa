        document.addEventListener('click', function(event) {
            var targetElement = event.target || event.srcElement;
            var joinNow = getClosest(targetElement, '.btn-join');
            var navJoin = getClosest(targetElement, '.join-btn');
            var desk = getClosest(targetElement, '.footer-desktop');
            var params = new URLSearchParams(window.location.search);
            var advrtsrv_id = params.get('advrtsrv_id');
            var additionalParams = "";
            if (advrtsrv_id) {
                additionalParams += "&advrtsrv_id=" + advrtsrv_id;
            }

            if ((joinNow || navJoin || desk) && advrtsrv_id) {
                event.preventDefault(); 
                if (joinNow) {
                    return window.location = joinNow.getAttribute("href")+ additionalParams;
                }

                if (navJoin) {
                    return window.location = navJoin.getAttribute("href")+ additionalParams;
                }

                if (desk) {
                    return window.location = desk.getAttribute("href")+ additionalParams;
                }
            }
        });
    });
</script>
